{
    "name": "copy_data_campaigncontents_pl",
    "properties": {
        "activities": [
            {
                "name": "OneToOneCopyPipeline",
                "description": "Copy data from rest api to sql database table",
                "type": "Copy",
                "dependsOn": [],
                "policy": {
                    "timeout": "00.12:00:00",
                    "retry": 1,
                    "retryIntervalInSeconds": 60,
                    "secureOutput": false,
                    "secureInput": false
                },
                "userProperties": [],
                "typeProperties": {
                    "source": {
                        "type": "RestSource",
                        "httpRequestTimeout": "00:01:40",
                        "requestInterval": "00.00:00:00.060",
                        "requestMethod": "GET",
                        "paginationRules": {
                            "AbsoluteUrl.{pagina}": "RANGE:1:9999:1",
                            "EndCondition:$['data']": "Empty"
                        }
                    },
                    "sink": {
                        "type": "AzureSqlSink",
                        "writeBehavior": "upsert",
                        "upsertSettings": {
                            "useTempDB": false,
                            "keys": [
                                "CampaignRepositoryContentID"
                            ],
                            "interimSchemaName": "Campaigns"
                        },
                        "sqlWriterUseTableLock": true,
                        "disableMetricsCollection": false
                    },
                    "enableStaging": false,
                    "translator": {
                        "type": "TabularTranslator",
                        "mappings": [
                            {
                                "source": {
                                    "path": "['CampaignRepositoryContentID']"
                                },
                                "sink": {
                                    "name": "CampaignRepositoryContentID",
                                    "type": "Int32"
                                }
                            },
                            {
                                "source": {
                                    "path": "['IsDeleted']"
                                },
                                "sink": {
                                    "name": "IsDeleted",
                                    "type": "Boolean"
                                }
                            },
                            {
                                "source": {
                                    "path": "['CampaignContentID']"
                                },
                                "sink": {
                                    "name": "CampaignContentID",
                                    "type": "Int32"
                                }
                            },
                            {
                                "source": {
                                    "path": "['RepositoryContentName']"
                                },
                                "sink": {
                                    "name": "RepositoryContentName",
                                    "type": "String"
                                }
                            },
                            {
                                "source": {
                                    "path": "['Size']"
                                },
                                "sink": {
                                    "name": "Size",
                                    "type": "Byte"
                                }
                            },
                            {
                                "source": {
                                    "path": "['IsTrash']"
                                },
                                "sink": {
                                    "name": "IsTrash",
                                    "type": "Boolean"
                                }
                            },
                            {
                                "source": {
                                    "path": "['FullPath']"
                                },
                                "sink": {
                                    "name": "FullPath",
                                    "type": "String"
                                }
                            },
                            {
                                "source": {
                                    "path": "['CampaignContentTypeID']"
                                },
                                "sink": {
                                    "name": "CampaignContentTypeID",
                                    "type": "Int32"
                                }
                            },
                            {
                                "source": {
                                    "path": "['CampaignContentTypeIdentifier']"
                                },
                                "sink": {
                                    "name": "CampaignContentTypeIdentifier",
                                    "type": "String"
                                }
                            },
                            {
                                "source": {
                                    "path": "['AuditCreatedDate']"
                                },
                                "sink": {
                                    "name": "AuditCreatedDate",
                                    "type": "DateTime"
                                }
                            },
                            {
                                "source": {
                                    "path": "['AuditLastUpdatedDate']"
                                },
                                "sink": {
                                    "name": "AuditLastUpdatedDate",
                                    "type": "DateTime"
                                }
                            },
                            {
                                "source": {
                                    "path": "$['metadata']['Page']"
                                },
                                "sink": {
                                    "name": "Page",
                                    "type": "Int16"
                                }
                            },
                            {
                                "source": {
                                    "path": "$['metadata']['PageSize']"
                                },
                                "sink": {
                                    "name": "PageSize",
                                    "type": "Int16"
                                }
                            },
                            {
                                "source": {
                                    "path": "$['metadata']['MaximumPageSize']"
                                },
                                "sink": {
                                    "name": "MaximumPageSize",
                                    "type": "Int16"
                                }
                            }
                        ],
                        "collectionReference": "$['data']",
                        "mapComplexValuesToString": false
                    }
                },
                "inputs": [
                    {
                        "referenceName": "campaigncontents_ep",
                        "type": "DatasetReference",
                        "parameters": {
                            "SetApiName": "campaigncontents?page={pagina}&page_size=5000&update_start_date=2024-02-12T23:59:59"
                        }
                    }
                ],
                "outputs": [
                    {
                        "referenceName": "campaigncontents_tb",
                        "type": "DatasetReference"
                    }
                ]
            }
        ],
        "folder": {
            "name": "CopyPipelines"
        },
        "annotations": [],
        "lastPublishTime": "2024-02-14T11:57:47Z"
    },
    "type": "Microsoft.DataFactory/factories/pipelines"
}